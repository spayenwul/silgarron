# ===================================
# AI API KEYS
# ===================================

# Google Gemini API Key
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===================================
# MODEL CONFIGURATION
# ===================================

# Which Gemini model to use
# Options: gemini-2.5-pro, gemini-2.0-flash-exp, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-pro

# Temperature for AI responses (0.0 - 1.0)
# Lower = more deterministic, Higher = more creative
AI_TEMPERATURE=0.7

# ===================================
# DATABASE
# ===================================

# Path to ChromaDB storage
CHROMA_DB_PATH=./db

# ===================================
# SERVER CONFIGURATION
# ===================================

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000

# Enable debug mode (more verbose logging)
DEBUG=False

# ===================================
# LOGGING
# ===================================

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log all LLM requests to file
LOG_LLM_REQUESTS=True

# ===================================
# GAME SETTINGS
# ===================================

# Maximum number of concurrent game sessions
MAX_SESSIONS=100

# Auto-save interval (in seconds)
AUTO_SAVE_INTERVAL=300

# Enable physics simulation cache
ENABLE_PHYSICS_CACHE=True

# ===================================
# DEVELOPMENT
# ===================================

# Enable CORS for frontend (set to False in production)
ENABLE_CORS=True

# Hot reload (for development)
RELOAD=True
